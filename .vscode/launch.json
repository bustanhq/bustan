{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pytest: IoC container unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/unit/core/ioc", "-q", "-p", "no:cacheprovider"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Pytest: current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-q", "-p", "no:cacheprovider"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "DI audit: debug current repro script",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "DI audit: run all repro scripts",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docs/audits/di-container-2026-09/run_repros.py",
            "args": ["${workspaceFolder}/docs/audits/di-container-2026-09/repros"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
